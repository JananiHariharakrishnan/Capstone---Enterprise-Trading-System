# Manifest: the names the check harness needs from your pipeline.
#
# The harness has no pipeline of its own and no opinion about the names in
# yours. It reads this file to learn what you called things, then asserts
# behaviour against those names. Fill it in as the functions appear, commit
# it, and update it when you rename something.

PACKAGE=analytics_etl

EXTRACT=analytics_etl.extract:extract
TRANSFORM=analytics_etl.transform:transform
LOAD=analytics_etl.load:load

MALFORMED_TEST=tests/test_transform.py::test_rejects_a_high_below_a_low